# Base URL of this deployment; must match exactly (see lib/api/guards.ts
# assertSameOrigin in a later PR). Preview deploys need their own value.
APP_ORIGIN=http://localhost:3000

# Neon Postgres connection string (neon-http driver).
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# HS256 signing secret for admin session JWTs (jose). Min 32 chars.
JWT_SECRET=

# HMAC signing secret for price-preview quote tokens. Min 32 chars.
QUOTE_SECRET=

# Optional: overrides the seeded admin password (db/seed.ts). Defaults to
# "changeme123!" when unset — do not rely on the default outside local dev.
SEED_ADMIN_PASSWORD=

# Google Maps Platform key, restricted to Directions API + Distance Matrix API.
# Used by lib/distance.ts to compute trip distance/duration for pricing.
GOOGLE_MAPS_API_KEY=

# Optional — approval emails via Resend (lib/notifications.ts). When unset,
# dispatches are recorded as "failed" notification rows instead of blocking.
RESEND_API_KEY=
# Sender address (must be a verified Resend domain; defaults to
# "Carhaus <onboarding@resend.dev>" when unset).
RESEND_FROM=

# Optional — fallback phone for wa.me deep links when a trip has no driver
# phone yet (design decision #6). Digits with country code, e.g. 549261XXX.
OPERATOR_WHATSAPP_NUMBER=
